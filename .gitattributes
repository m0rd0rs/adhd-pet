# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Godot scene, script, and resource files (always text)
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.gdshader text eol=lf
*.import text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Git LFS: 3D Models & Assets
*.blend filter=lfs diff=lfs merge=lfs -text
